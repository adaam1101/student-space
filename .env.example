# ============================================================================
# ADAM AMEYOUD — ENGLISH LANGUAGE ASSESSMENT
# Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your Supabase project credentials.
# ============================================================================

# Public Supabase URL & Anonymous Key (safe for browser client with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Service Role Key (NEVER expose with NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Session Secret (used for HMAC-SHA256 signed HTTP-only session tokens)
SESSION_SECRET=adam-ameyoud-assessment-super-secret-key-change-in-production-2026

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Teacher & Seed Credentials (used during initial seeding)
INITIAL_TEACHER_USERNAME=adamameyoud
INITIAL_TEACHER_PASSWORD=adamadam
INITIAL_B1_EXAM_ACCESS_CODE=B1FINAL2026
